# ConvertKit Configuration
CONVERTKIT_KEY=
CONVERTKIT_SECRET=
FORM_ID=

# AI API Keys
ANTHROPIC_API_KEY=

# Unsplash
UNSPLASH_ACCESS_KEY=

# Google Analytics (optional)
GTAG=

# Sanity (the blog's CMS; editor at /studio). Project id + dataset from manage.sanity.io; the secret is any random string,
# also entered on the project's webhook so /api/revalidate can verify it.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=
# Only for scripts/migrate-posts-to-sanity.mjs. An Editor token from manage.sanity.io → API → Tokens. Never needed by the site.
SANITY_API_WRITE_TOKEN=
